# Example configuration. Export these, or run: node --env-file=.env apps/server/dist/server.mjs
PORT=8787
HOST=0.0.0.0
# demo = always-open simulated session, live = follow the real IST market clock
CLOCK_MODE=demo
SIM_SPEED=1
# SIM_START=2026-10-09T11:30
MARKET_SEED=q26
RISK_FREE_RATE=0.065
# HOLIDAYS=2026-10-20,2026-11-09
# Set a long random value in production so sessions survive restarts
AUTH_SECRET=change-me
# DATA_DIR=./apps/server/data
PERSIST=true
