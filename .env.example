# Example configuration. Copy to .env (repository root) and fill in; the server loads it at start
# (variables already set in the environment win). Never commit .env.

# --- Kotak Neo Trade API credentials (all five required for live data) ---
# API access token from the Neo dashboard
NEO_CONSUMER_KEY=
# Registered mobile number (10 digits, optionally prefixed with +91)
NEO_MOBILE_NUMBER=
# Client code (UCC)
NEO_UCC=
# MPIN (digits)
NEO_MPIN=
# Base32 TOTP setup key
NEO_TOTP_SECRET=

# --- Server ---
PORT=8787
HOST=0.0.0.0
# Risk-free rate for IV, Greeks and margin estimates
RISK_FREE_RATE=0.065
# Extra exchange holidays, merged with NSE's holiday master
# HOLIDAYS=2026-10-20,2026-11-09
# Full-day MCX closures (MCX keeps trading on most NSE holidays): comma-separated YYYY-MM-DD
# MCX_HOLIDAYS=
# Set a long random value in production so sessions survive restarts
# A long random value (at least 16 characters), e.g. the output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A placeholder such as change-me is ignored (a random secret is used and sign-ins end at restart).
AUTH_SECRET=
# Accounts allowed to use the dashboard's operations buttons (Re-login now, health check, audit),
# comma-separated e-mails. Empty: only the first account registered on this server.
# OPS_ADMIN_EMAILS=you@example.com
# Optional: alerts (watchdog CRITICAL, login PAUSED, audit FAIL) to a Slack / Discord / ntfy webhook
# ALERT_WEBHOOK_URL=
# Behind a reverse proxy: its address(es), so rate limits apply per real client
# TRUST_PROXY=127.0.0.1
# User data, recorded sessions and official EOD files
# DATA_DIR=./apps/server/data
PERSIST=true
# Sessions checked for missing NSE/BSE end-of-day files at start and daily (0 = none)
# EOD_BACKFILL_DAYS=30
# The app's ONLY stocks: the NIFTY top 10 by market cap (comma-separated F&O symbols). No other stock is listed
# anywhere (chain, scanners, F&O market, streaming, EOD files). Default: RELIANCE,HDFCBANK,BHARTIARTL,ICICIBANK,
# SBIN,TCS,BAJFINANCE,LT,SUNPHARMA,INFY (ranking of 1 Oct 2026). Indices and MCX commodities are not affected.
# NIFTY_TOP10=
# Cap on streamed SFeed subscriptions (at most 2700)
# SFEED_TOKEN_BUDGET=2700
# Built web app served by the API
# WEB_DIST=./apps/web/dist
